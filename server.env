DB_URL=jdbc:postgresql://termx-postgres:5432/termx
DB_APP_PASSWORD=test
DB_ADMIN_PASSWORD=test
DB_POOL_SIZE=10

MICRONAUT_SERVER_CORS_ENABLED=true
#Xmx - max memory amount; auth.dev.allowed - activation of guest mode; HttpClient - logging of the all external REST requests (Snowstorm, GitHub, ...)
JAVA_OPTS=-Xmx1800m -Dauth.dev.allowed=true -Dio.netty.leakDetection.level=advanced -Djdk.httpclient.HttpClient.log=requests,headers,content

# Externally-reachable addresses of THIS deployment. TERMX_API_URL is not cosmetic: it becomes
# CapabilityStatement.implementation.url and the `servers` entry in /api/fhir-swagger, i.e. it is
# what tells FHIR clients where to send requests. Leave it unset and the server falls back to a
# built-in default, which is how deployments ended up advertising someone else's host.
# Behind nginx/TLS, set both to your public address (e.g. https://termx.site.org[/api]).
TERMX_WEB_URL=http://localhost:4200
TERMX_API_URL=http://localhost:8200/api

# Internal address of the Chef (SUSHI/GoFSH) service — called by the server, never advertised.
CHEF_URL=http://fsh-chef:3000

BOB_MINIO_URL=http://termx-minio:9000
BOB_MINIO_ACCESS_KEY=bob
BOB_MINIO_SECRET_KEY=bobobobo

SNOWSTORM_URL=https://snomed.termx.org/snowstorm/snomed-ct/
#SNOWSTORM_URL=http://localhost:8080/
SNOWSTORM_BRANCH=MAIN
#SNOWSTORM_BRANCH=MAIN/SNOMEDCT-EE
